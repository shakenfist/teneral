00 00 00 00                                      # secs, flags
00 00 00 00                                      # ciaddr 0.0.0.0
0a 00 00 f1                                      # yiaddr 10.0.0.241
0a 00 00 01                                      # siaddr 10.0.0.1
00 00 00 00                                      # giaddr 0.0.0.0

